<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- playing on with the screen off: a foreground service of type media playback, and the player's wake lock -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Since Android 11 an app cannot see other apps unless it asks. Without this Shelby cannot see the TV's launcher, so
         Android cannot say the launcher is trusted, PlaybackService turns it away, and the pause and skip buttons on the
         launcher's now-playing card do nothing (the remote's media keys still worked: they come from the system itself).
         Only the home screen is asked for, not any one launcher by name. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".ShelbyApplication"
        android:allowBackup="false"
        android:label="Shelby"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shelby"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported so the system can reach it (the remote's media keys, the TV's now-playing controls); PlaybackService
             accepts only this app, what Android calls trusted (the system, the launcher: see queries above) and its own
             notification as controllers. -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
