# Settings for all of Shelby. ./start reads this and every tool inherits it.
# Copy to .env and edit; .env itself is never committed.

# The model. Only Chat and Meetings' notes and minutes use one: every other page works without it.
#
# Either an Anthropic API key, the simpler way (no daily login, works from anywhere):
# ANTHROPIC_API_KEY=
# and, only if the default model is not one your key can use (Settings says so), its id:
# SHELBY_MODEL=
#
# Or AWS Bedrock with an SSO profile (its login lapses overnight: ./auth renews it), and, only to use another model
# than Opus 4.6 there, its profile id:
AWS_PROFILE=ayadata-bedrock
AWS_REGION=us-east-1
# SHELBY_BEDROCK_MODEL=us.anthropic.claude-opus-4-6-v1
#
# With both set up, Settings has a switch between them (Chat and meeting notes follow it). Until it is used, the key wins.

# The backend's API. It only ever listens on 127.0.0.1. (The web app is on 8751; see web/.)
ASSISTANT_PORT=8750
# The access token between the web app and the backend. ./start makes a new random one on
# every launch and hands it to both, so there is nothing to set. Fix one here only if you run
# the backend and the web app separately and want them to agree without pasting.
# ASSISTANT_TOKEN=
# The TV app's token (tv/): a second one that may play audiobooks and nothing else (assistant/CLAUDE.md ->
# Scoped tokens). Unlike the one above it is fixed, because the TV has it built in. Make one with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# At least 24 characters, and not the same as the launch token. Unset: the TV has no way in.
# ASSISTANT_TV_TOKEN=
# The laptop's address on the home network. Set, ./start-docker up also publishes the backend's port on that ONE address
# (compose.home.yaml), for the TV app (tv/), and lists it as a Host the backend answers to. A private address this machine
# has right now, or `up` stops before it starts anything. Give the laptop a fixed address in the router, or the TV loses it.
# Anything on that network can then reach the port: the tokens and the Host list stop it, and the TV's own token can only
# play audiobooks. Unset: nothing is published beyond 127.0.0.1.
# SHELBY_HOME_ADDRESS=192.168.1.20

# --- Google sign-in (optional: the assistant's own login, not the tool credentials) ----------------
# Create a Web Application OAuth client in the same Google Cloud project as docu-ai/mail-ai,
# scopes openid and email only, redirect URI matching GOOGLE_REDIRECT_URI below.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8750/auth/callback
# Comma-separated Google account emails allowed to sign in.
# ASSISTANT_ALLOWED_EMAILS=you@gmail.com

# --- ngrok (./start --ngrok or ./start-docker up --ngrok) ------------------------------------------
# An ngrok auth token (https://dashboard.ngrok.com/get-started/your-authtoken). Each tunnel gets a
# random HTTPS hostname; the scripts discover the URLs from ngrok's local API at startup.
# NGROK_AUTHTOKEN=
# A free static domain for the web app (https://dashboard.ngrok.com/domains), so the URL stays
# the same across restarts. The API tunnel stays random and is discovered automatically.
# NGROK_WEB_DOMAIN=your-name.ngrok-free.dev

# --- Containers (./start-docker) -------------------------------------------------------------------
# The name your devices reach it by over Tailscale, e.g. shelby.tail1234.ts.net -- shown in the
# Tailscale admin console once the `shelby` machine has joined. Until it is set, the container setup
# works on localhost only.
# SHELBY_HOST=
# A Tailscale auth key (a reusable, tagged one for an always-on server), so the `shelby` machine joins
# without a sign-in link. Left empty, its log prints a link to open once.
# TS_AUTHKEY=
# Fix a token across restarts (otherwise ./start-docker makes a new one each time it runs).
# ASSISTANT_TOKEN=
# The speech models (Whisper, Pocket TTS) use an NVIDIA card by themselves when there is one, which costs
# about 4 GB of NVIDIA's libraries. cpu keeps everything on the CPU even so; nvidia skips the looking.
# Read by ./setup and ./start-docker.
# SHELBY_GPU=auto

# --- The database (./start-docker) -----------------------------------------------------------------------
# Memory, the audit log and sign-in sessions live in a PostgreSQL container that nothing outside the
# containers can reach. Its password is only ever used on that private network; change it before the
# first start (letters and digits), because the database keeps the one it was created with.
# POSTGRES_PASSWORD=shelby

# --- A server you renew logins for (./renew-secrets) -----------------------------------------------
# The ssh host alias of the machine running ./start-docker, reached however you reach it (for a server
# behind SSM, an alias whose ProxyCommand runs `aws ssm start-session`; README -> "On a server").
# SHELBY_REMOTE=
# Where Shelby lives there (relative to that user's home), and the folder that holds only Shelby's
# AWS credentials. Set AWS_CONFIG_DIR to the second one's full path in the *server's* .env.
# SHELBY_REMOTE_DIR=shelby
# SHELBY_REMOTE_AWS_DIR=shelby-aws
