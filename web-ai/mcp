#!/usr/bin/env bash
# web-ai's MCP front door, over stdio. Nothing may be written to stdout but protocol.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# This tool's own environment if it has one; otherwise Shelby's, one folder up. So the
# tool runs the same whether it is checked out alone or as part of Shelby.
PY="$DIR/.venv/bin/python"
[[ -x "$PY" ]] || PY="$(cd "$DIR/.." && pwd)/.venv/bin/python"  # normalised: Python 3.14 warns about ".." in its prefix
if [[ ! -x "$PY" ]]; then
  echo "No Python environment. In Shelby: run ./setup at its top. Alone: python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  exit 1
fi

export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m webai.mcp_server "$@"
