#!/usr/bin/env bash
# Install everything the suite needs, once: one Python environment shared by the three
# light Python tools, audiobook's own (torch, Docling and Pocket TTS are ~1.9 GB nothing else
# uses), docu-ai's Node packages, the web app's packages and build, and meet-ai's speaker models.
# Safe to re-run; each step skips what is already done. Touches nothing outside this folder
# except where npm and pip keep their caches.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

# Fingerprint of everything ./setup installs from; ./setup stores it in .venv/.setup-stamp.
deps_hash() { cat {assistant,meet-ai,mail-ai,apply-ai,web-ai,audiobook}/requirements*.txt docu-ai/package-lock.json web/package-lock.json 2>/dev/null | sha256sum | cut -d' ' -f1; }

step() { printf '\n==> %s\n' "$*"; }
need() { command -v "$1" >/dev/null || { echo "missing: $1 — $2" >&2; exit 1; }; }

need python3 "install Python 3.14"
need node    "install Node 24"
need npm     "install Node 24"
need ffmpeg  "meet-ai records and decodes audio with it"

# The speech models (Whisper in meet-ai, Pocket TTS in audiobook) use an NVIDIA card when there is one,
# which needs NVIDIA builds of their libraries: found by its driver answering. SUITE_GPU in .env or the
# environment overrides it: cpu installs the CPU builds even so, nvidia installs NVIDIA's without asking.
[[ -z "${SUITE_GPU:-}" && -f .env ]] && SUITE_GPU="$(sed -n 's/^SUITE_GPU=//p' .env | tail -1)"
case "${SUITE_GPU:-auto}" in
  cpu|nvidia) gpu="$SUITE_GPU" ;;
  *) if nvidia-smi -L >/dev/null 2>&1; then gpu=nvidia; else gpu=cpu; fi ;;
esac
nvidia=()
if [[ $gpu == nvidia ]]; then
  echo "An NVIDIA card: the speech models get NVIDIA's builds (about 4 GB more to download)."
  nvidia=(-r meet-ai/requirements-nvidia.txt)
fi

step "Python environment (.venv), shared by assistant, meet-ai, mail-ai, apply-ai and web-ai"
[[ -x .venv/bin/python ]] || python3 -m venv .venv
.venv/bin/pip install -q --upgrade pip
.venv/bin/pip install -q \
  -r assistant/requirements.txt \
  -r meet-ai/requirements.txt -r meet-ai/requirements-dev.txt "${nvidia[@]}" \
  -r mail-ai/requirements.txt -r mail-ai/requirements-dev.txt \
  -r apply-ai/requirements.txt -r apply-ai/requirements-dev.txt \
  -r web-ai/requirements.txt -r web-ai/requirements-dev.txt
.venv/bin/pip check

step "audiobook's own Python environment (audiobook/.venv)"
[[ -x audiobook/.venv/bin/python ]] || python3 -m venv audiobook/.venv
audiobook/.venv/bin/pip install -q --upgrade pip
audiobook/install-deps audiobook/.venv/bin/python "$gpu"
[[ -f audiobook/.env ]] || echo "  audiobook/.env is missing: cloned voices need HF_TOKEN=<a Hugging Face token> in it (see audiobook/CLAUDE.md)."

step "docu-ai (Node)"
(cd docu-ai && npm ci --silent)

step "Web app (its own program, in web/)"
(cd web && npm ci --silent && npm run --silent build)

step "meet-ai speaker models"
meet-ai/fetch-models.sh

[[ -f .env ]] || { cp .env.example .env; echo; echo "Wrote .env from .env.example — check the AWS profile in it."; }

deps_hash > .venv/.setup-stamp   # which requirements this environment was built from

step "Logins"
./auth --check || echo "  Sign in with ./auth (it opens a browser only for the logins that need one)."
echo
echo "Done. Start with ./start"
